APP_NAME=TabangNow
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-production-domain.example
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

CACHE_STORE=database
CACHE_PREFIX=tabangnow_cache_

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# For managed platforms where every public request enters through the platform
# proxy, use "*". For direct hosting, leave blank or list approved proxy IPs.
TRUSTED_PROXIES=

SECURITY_HEADERS_ENABLED=true
SECURITY_FRAME_OPTIONS=SAMEORIGIN
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_PERMISSIONS_POLICY="accelerometer=(), autoplay=(), camera=(), geolocation=(self), gyroscope=(), microphone=(), payment=(), usb=()"

# Enable only after the final domain works permanently over HTTPS.
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=31536000
SECURITY_HSTS_INCLUDE_SUBDOMAINS=false
SECURITY_HSTS_PRELOAD=false

# Start with report-only mode and inspect browser violations before enforcing.
SECURITY_CSP_ENABLED=false
SECURITY_CSP_REPORT_ONLY=true
SECURITY_CSP_POLICY="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob: https:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https: wss:"

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

# Transactional email via Brevo HTTPS API.
# Keep BREVO_API_KEY only in the deployment environment; never commit a real key.
MAIL_MAILER=brevo
BREVO_API_KEY=
MAIL_FROM_ADDRESS=no-reply@your-production-domain.example
MAIL_FROM_NAME="${APP_NAME}"

BROADCAST_CONNECTION=log

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Encrypted off-site production backups (Google Drive)
# Use a dedicated OAuth client with the drive.file scope.
BACKUP_ENABLED=false
BACKUP_SCHEDULE_TIME=03:15
BACKUP_RETENTION_COUNT=14
BACKUP_ENCRYPTION_KEY=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_BACKUP_ROOT_FOLDER="TabangNow Backups"
# Android APK distribution and in-app update policy
TABANGNOW_APK_VERSION=1.0.0
TABANGNOW_APK_BUILD_NUMBER=1
TABANGNOW_MIN_SUPPORTED_BUILD_NUMBER=1
TABANGNOW_UPDATE_MESSAGE="A newer version of TabangNow is available."
TABANGNOW_APK_DOWNLOAD_URL=
TABANGNOW_APK_SHA256=
TABANGNOW_APK_SIZE_BYTES=
